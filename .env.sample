# Gemini (either name works; API_KEY matches docker run -e API_KEY=...)
API_KEY=
GEMINI_API_KEY=
GEMINI_FILE_SEARCH_STORE_NAME=fileSearchStores/YOUR_STORE_ID

# Zendesk Help Center origin (no /api path)
HELP_CENTER_BASE_URL=https://support.optisigns.com
HELP_CENTER_LOCALE=en-us

# Optional overrides
ARTICLES_DIR=articles
STATE_PATH=state.json
MIN_ARTICLES=30
CHUNK_SIZE=2000
CHUNK_OVERLAP=200

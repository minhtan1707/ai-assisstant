# Provider switch: gemini | openai
INGEST_PROVIDER=openai

# Shared API auth for Cloud Run Service (X-API-Key header)
SERVICE_API_KEY=change-me
GEMINI_CHAT_MODEL=gemini-2.0-flash
OPENAI_CHAT_MODEL=gpt-4.1-mini
# Gemini
API_KEY=
GEMINI_API_KEY=
GEMINI_FILE_SEARCH_STORE_NAME=fileSearchStores/optisignshelp-ck2ai6kdse6e

# OpenAI (Playground / file_search)
OPEN_AI_API_KEY=
OPENAI_VECTOR_STORE_ID=vs_6aba3fdae1c88191b8a143612dea342a


# Zendesk Help Center origin (no /api path)
HELP_CENTER_BASE_URL=https://support.optisigns.com
HELP_CENTER_LOCALE=en-us

# Optional overrides
ARTICLES_DIR=articles
STATE_PATH=state.json
MIN_ARTICLES=30
CHUNK_SIZE=2000
CHUNK_OVERLAP=200

# Cloud Run mounts Secret Manager AI_ASSISTANT_ENV at this path
# DOTENV_PATH=/secrets/.env
